# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# An RPC endpoint for Base Sepolia. Use your own provider key here; the value in
# this example file is deliberately a placeholder, not a working authenticated URL.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan key, only needed for --verify.
BASESCAN_API_KEY=your_basescan_api_key_here

# Optional: EAS deployment to use. Defaults to the Base Sepolia predeploys.
# Verify against https://docs.attest.org/docs/quick--start/contracts for other chains.
EAS_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020

# Optional: who holds DEFAULT_ADMIN_ROLE and REGISTRAR_ROLE.
# Defaults to the broadcasting account. If you set it to a different address, that
# address must call resolver.bindRegistry() itself after deployment.
REGISTRY_ADMIN=0x0000000000000000000000000000000000000000

# NOTE: no private key is read from this file. Prefer an encrypted keystore:
#   cast wallet import devcon --interactive
#   forge script script/Deploy.s.sol:Deploy --rpc-url base_sepolia --account devcon --broadcast
